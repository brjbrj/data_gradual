CONDA_SH=/jizhicfs/hymiezhao/miniconda3/etc/profile.d/conda.sh
PIPELINE_CONDA_ENV=
PIPELINE_PYTHON=/jizhicfs/hymiezhao/miniconda3/envs/brj/bin/python
VLLM_CONDA_ENV=
VLLM_PYTHON=/jizhicfs/hymiezhao/miniconda3/envs/brjqwen/bin/python

PROJECT_DIR=/jizhicfs/hymiezhao/lpc/repos/brj/data_gradual_V1.1.0
MODEL_DIR=/jizhicfs/hymiezhao/lpc/repos/brj/models

EVAL_MODEL=${MODEL_DIR}/Meta-Llama-3-8B-Instruct
EVAL_BASE_URL=http://127.0.0.1:8911/v1
EVAL_API_KEY=EMPTY
EVAL_INPUT_PATH=${PROJECT_DIR}/data/gsm8k.jsonl
EVAL_OUTPUT_DIR=${PROJECT_DIR}/outputs/evaluation/gsm8k
EVAL_N_ANSWERS=10
EVAL_TEMPERATURE=0.3
EVAL_TOP_P=0.95
EVAL_MAX_TOKENS=1200
EVAL_CONCURRENCY=128
EVAL_ANSWER_EXTRACT_MODE=number

VLLM_BASE_URL=http://127.0.0.1:8911/v1
VLLM_API_PORT=8911
VLLM_PID_FILE=${PROJECT_DIR}/outputs/runtime/vllm/vllm.pid
VLLM_LOG_FILE=${PROJECT_DIR}/outputs/runtime/vllm.log
VLLM_CUDA_VISIBLE_DEVICES=0,1,2,3
