CONDA_SH=/jizhicfs/hymiezhao/miniconda3/etc/profile.d/conda.sh
PIPELINE_CONDA_ENV=
PIPELINE_PYTHON=/jizhicfs/hymiezhao/miniconda3/envs/brj/bin/python
VLLM_CONDA_ENV=
VLLM_PYTHON=/jizhicfs/hymiezhao/miniconda3/envs/brjqwen/bin/python

PROJECT_DIR=/jizhicfs/hymiezhao/lpc/repos/brj/data_gradual_V1.1.0
MODEL_DIR=/jizhicfs/hymiezhao/lpc/repos/brj/models

VLLM_MODEL=${MODEL_DIR}/Qwen3.6-27B/
VLLM_BASE_URL=http://127.0.0.1:8911/v1
VLLM_API_KEY=EMPTY
VLLM_RUNTIME_MODE=managed
VLLM_START_TIMEOUT=10000
VLLM_START_POLL_SEC=5
VLLM_EXTERNAL_WAIT_TIMEOUT=-1
VLLM_EXTERNAL_POLL_SEC=5

VLLM_LOG_FILE=${PROJECT_DIR}/outputs/runtime/vllm.log
VLLM_PID_FILE=${PROJECT_DIR}/outputs/runtime/vllm/vllm.pid
VLLM_FOREGROUND_LOG=1
VLLM_LOG_APPEND=0
VLLM_HOST=
VLLM_API_PORT=8911
VLLM_TP=4
VLLM_MAX_MODEL_LEN=
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_ENABLE_AUTO_TOOL_CHOICE=1
VLLM_TOOL_CALL_PARSER=hermes
VLLM_ENFORCE_EAGER=0
VLLM_DISABLE_CUSTOM_ALL_REDUCE=0
VLLM_TIMEOUT=600
VLLM_MAX_RETRIES=2

VLLM_CUDA_VISIBLE_DEVICES=0,1,2,3
VLLM_NCCL_DEBUG=INFO
VLLM_NCCL_BLOCKING_WAIT=1
VLLM_NCCL_P2P_DISABLE=0
VLLM_NCCL_IB_DISABLE=0
VLLM_NCCL_SOCKET_IFNAME=inherit
VLLM_TORCH_NCCL_BLOCKING_WAIT=inherit
VLLM_NCCL_ALGO=inherit
VLLM_NCCL_P2P_LEVEL=inherit
VLLM_NCCL_PXN_DISABLE=inherit
VLLM_NCCL_CUMEM_ENABLE=inherit
VLLM_GLOO_SOCKET_IFNAME=inherit
VLLM_HOST_IP_CONFIG=inherit
VLLM_ATTENTION_BACKEND=XFORMERS
VLLM_USE_FLASH_ATTN=0
VLLM_USE_FLASHINFER=0
FLASHINFER_DISABLE_JIT=1
VLLM_USE_V1=0
VLLM_EXPECTED_VERSION=0.19.0

VICTIM_MODEL=${MODEL_DIR}/Meta-Llama-3-8B-Instruct
STEP_MODEL=${MODEL_DIR}/Qwen3.6-27B/
QC_MODEL=${MODEL_DIR}/Qwen3.6-27B/
GEN_MODEL=${MODEL_DIR}/Qwen3.6-27B/
REPAIR_MODEL=${MODEL_DIR}/Qwen3.6-27B/

DATASET_NAME=gsm8k
INPUT_PATH=${PROJECT_DIR}/data/gsm8k.jsonl
OUTPUT_DIR=${PROJECT_DIR}/outputs
OUTPUT_BASE_DIR=${PROJECT_DIR}/outputs/experiments
STAGE_VLLM_MODE=managed
STAGE_VLLM_STOP_ON_EXIT=1
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1
