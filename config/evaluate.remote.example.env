CONDA_SH=/root/miniconda3/etc/profile.d/conda.sh
PIPELINE_CONDA_ENV=brj
PIPELINE_PYTHON=
VLLM_CONDA_ENV=qwen
VLLM_PYTHON=

EVAL_MODEL=/root/brjverl/models/Meta-Llama-3-8B-Instruct
EVAL_BASE_URL=http://127.0.0.1:8911/v1
EVAL_API_KEY=EMPTY
EVAL_INPUT_PATH=/root/brjverl/data_gradual_new/data/gsm8k.jsonl
EVAL_OUTPUT_DIR=/root/brjverl/data_gradual_new/outputs/evaluation/gsm8k
EVAL_N_ANSWERS=10
EVAL_TEMPERATURE=0.3
EVAL_TOP_P=0.95
EVAL_MAX_TOKENS=1200
EVAL_CONCURRENCY=128
EVAL_ANSWER_EXTRACT_MODE=number

VLLM_BASE_URL=http://127.0.0.1:8911/v1
VLLM_API_PORT=8911
VLLM_PID_FILE=/root/brjverl/data_gradual_new/outputs/runtime/vllm/vllm.pid
VLLM_LOG_FILE=/root/brjverl/data_gradual_new/outputs/runtime/vllm.log
VLLM_CUDA_VISIBLE_DEVICES=0,1
